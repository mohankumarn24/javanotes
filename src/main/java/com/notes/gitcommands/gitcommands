// http://blog.udacity.com/2015/06/a-beginners-git-github-tutorial.html

mkdir gitdir 			    			// create root directory for a git project
cd gitdir		            			// go to the newly created directoey
git init			    				// initialize github project repository

// add remote repository
git remote add origin <https://github.com/mohankumarn24/repoName.git>

// commands used regularly
git branch                          	// list all available branches
git checkout dev/feature 	          	// switch to branch dev/feature
										// Create & switch to a new branch dev/feature => git checkout -b dev/feature 
git pull origin dev/feature				// pull latest first
                      
vi Main.java                           	// make changes to Main.java file in dev/feature
git status                          	// check status 
git diff Main.java                     	// gives diff between committed and not-committed file

git add Main.java                      	// add dev/feature to stage
git commit -m "written Java program"   	// commit changes to dev/feature
git push origin dev/feature				// push to your branch dev/feature

git checkout master                 	// switch to master
git pull origin master					// if master has moved ahead, pull latest first
git merge dev/feature                  	// merge dev/feature into master
git push origin master					// push the updated master
										// or use => git push --force origin master

git log				    				// view change history
git fetch --prune						// Clean up local tracking references

-----------------------------------------------------------------------------------------------
// delete commands
git rm Main.java						// delete file
git commit -m "Deleting files"			// commit changes to your branch
git branch -d dev/feature               // delete local branch									 
										// git branch -D dev/feature => force delete
git push origin --delete dev/feature	// delete remote branch

