mkdir gitdir 			    			// create root directory for a git project
cd gitdir		            			// go to the newly created directoey
git init			    				// initialize github project repository

touch test.c    		    			// create empty file
git status    			    			// check status 

git add test.c  	  	    			// add test.c to stage  
git commit -m "empty file created"  	// commit changes to master branch

git branch                          	// list available branches

git checkout -b branch1             	// create new branch branch1                        
vi test.c                           	// make changes to test.c file in branch1
git status                          	// check status 
git add test.c                      	// add test.c to stage
git diff test,c                     	// gives diff between committed and not-committed file
git commit -m "written c program"   	// commit changes to branch1

git checkout master                 	// switch to master
git merge branch1                   	// merge changes done in branch1 to master

git log				    				// view change history

git fetch --prune						// cleaning up local Git branches that no longer exist on remote
										// make local Git references are up-to-date with the remote repository
-----------------------------------------------------------------------------------------------
// add remote repository
git remote add origin <https://github.com/userName/repoName.git>
 
// files copied from local system(master) to github server
git checkout master
git push origin master              	// or use => git push --force origin master		    
              
// files copied from github server to local system(branch1)
git checkout branch1
git pull origin branch1		    

-----------------------------------------------------------------------------------------------
// delete file
git rm test.c

// commit changes to branch
git commit -a -m "Deleting files"

// delete local branch
git branch -d branch1                	// git branch -D branch1 => force delete

// delete remote branch
git push origin --delete branch1

